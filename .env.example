# 苹果开发者公证与自动更新环境变量配置示例
# 复制为 .env 并在打包前 source .env，或直接在终端 export

# 1. 你的 Apple ID 邮箱
APPLE_ID="your-apple-id@example.com"

# 2. 苹果后台生成的 App 专用密码 (在 appleid.apple.com 生成，非登录密码)
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# 3. 苹果开发者后台的 10 位 Team ID (在 developer.apple.com 右上角)
APPLE_TEAM_ID="XXXXXXXXXX"

# 4. 具有 releases 写入权限的 GitHub Personal Access Token (PAT)
GH_TOKEN="github_pat_xxxxxxxxxxxxxxxxxxxx"
